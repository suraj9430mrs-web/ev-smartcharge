# EV SmartCharge - Environment Configuration
# Copy this file to .env and update values

# Server port (default: 8080)
PORT=8080

# Database file path (default: ev_smartcharge.db)
DATABASE_PATH=ev_smartcharge.db

# Admin credentials (seeded on first run)
ADMIN_EMAIL=admin@smartcharge.in
ADMIN_PASSWORD=<change-this-to-a-strong-password>

# SMTP Configuration (optional - for password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

